{
  "name": "transaction-ledger-api",
  "version": "1.0.0",
  "description": "RESTful transaction ledger API with account management, credit/debit operations, and transaction history.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:migrate": "sequelize-cli db:migrate --env development",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --env development",
    "db:migrate:status": "sequelize-cli db:migrate:status --env development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaustubhchaudhari05/transaction-ledger-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kaustubhchaudhari05/transaction-ledger-api/issues"
  },
  "homepage": "https://github.com/kaustubhchaudhari05/transaction-ledger-api#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}